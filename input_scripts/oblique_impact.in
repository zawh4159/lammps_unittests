############################
### Simulation Parameters ##
############################
units           si
dimension       3
boundary        f f f

atom_style      sphere
region          box block -1 1 -1 1 -1 1
create_box      1 box

create_atoms    1 single 0 0 0

neighbor        0.3 bin
neigh_modify    delay 0
comm_modify     vel yes

############################
### Numerical Parameters ###
############################
variable        dt equal 1e-8
variable        vel equal 3.9

variable        theta equal $((25/360)*(2*PI)) #/
variable        vx equal $(v_vel*cos(v_theta))
variable        vy equal $(v_vel*sin(v_theta))

variable        Nrun equal 5e6
variable        nout equal 1000#$(ceil(v_Nrun/100))

############################
### Material Parameters  ###
############################
# Fixed constants
variable        Emod equal 7e10
variable        Poissons equal 0.33
variable        Rho equal 2700
variable        D equal 0.005

variable        e equal 0.98
variable        mu equal 0.092

#Set properties
set             type 1 diameter ${D}
set             type 1 density ${Rho}

############################
###   Wall Interacions ###
############################

fix             1 all wall/gran granular hertz/material ${Emod} ${e} ${Poissons} tangential mindlin NULL 0.5 ${mu} damping coeff_restitution xplane -0.8 0.01 
run             0

############################
# Final fixes and computes #
############################
fix             2 all nve/sphere
variable 	    STEP equal step

group		    particle type 1

run             0

compute         1 particle property/atom omegax omegay omegaz
compute         2 particle reduce min c_1[3] 

variable 	    xcom equal xcm(particle,x)
variable	    vxcom equal vcm(particle,x)
variable	    vycom equal vcm(particle,y)
variable	    fcom equal fcm(particle,x)

variable        omega equal c_2

run             0 

velocity 	    particle set ${vx} ${vy} 0

# Dumps and prints
dump            1 all custom ${nout} dump/atom.dump id type xs ys zs vx vy vz fx fy fz c_1[1] c_1[2] c_1[3]
fix             printF all print ${nout} "${STEP} ${xcom} ${vxcom} ${vycom} ${fcom} ${omega}" file dump/normal_contact.out screen no title ""

############################
# Run  #
############################
timestep        ${dt}
run             ${Nrun}