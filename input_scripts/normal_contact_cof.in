############################
### Simulation Parameters ##
############################
units           si
dimension       3
boundary        f f f

atom_style      sphere
region          box block -1 1 -1 1 -1 1
create_box      1 box

create_atoms    1 single 0 0 0

neighbor        0.3 bin
neigh_modify    delay 0
comm_modify     vel yes


############################
### Numerical Parameters ###
############################
variable        dt equal 1e-8
variable        vel equal 3.9

variable        Nrun equal 5e6
variable        nout equal 1000#$(ceil(v_Nrun/100))

############################
### Material Parameters  ###
############################
# Fixed constants
variable        Emod equal 1e11
variable        Poissons equal 0.25
variable        Rho equal 7000
variable        D equal 0.005

variable        e equal 1

#Set properties
set             type 1 diameter ${D}
set             type 1 density ${Rho}

############################
## Pair & Wall Interacions #
############################
#pair_style      granular
#pair_coeff      * * hertz/material ${Emod} ${e} ${Poissons} tangential linear_nohistory 0.0 0.0

fix             1 all wall/gran granular hertz/material ${Emod} ${e} ${Poissons} tangential linear_nohistory 0.0 0.0 damping coeff_restitution xplane -0.8 0.01 

run             0

############################
# Final fixes and computes #
############################
fix             2 all nve/sphere
variable 	    STEP equal step

group		    particle type 1

run             0

variable 	    xcom equal xcm(particle,x)
variable	    vcom equal vcm(particle,x)
variable	    fcom equal fcm(particle,x)

#compute 1 group-ID style args

run             0 

velocity 	    particle set ${vel} 0 0

# Dumps and prints
#dump            1 all custom ${nout} output/atom.dump id type xs ys zs vx vy vz fx fy fz
fix             printF all print ${nout} "${STEP} ${xcom} ${vcom} ${fcom}" file dump/normal_contact.out screen no title ""

############################
# Run  #
############################
timestep        ${dt}
run             ${Nrun}