###             Simulation Parameters (timesteps, number of particles)

variable        thermo_freq     equal 1000
variable        runtime 	equal 0.04 # s  

# units are: 1 kg, 1 m, 1 s

# All material properties and starting configuration data from Chung & Ooi, Granular Matter 2011 13:643-656
#Baseds on Glass spheres from Test No.8


############################# Interaction parameters ###################

variable   Emod equal 7.00e10 			# 7.00e10 N/m^2 => Young's Modulus
variable   poisson equal 0.33 			#Poisson's Ratio
variable   mus equal 0.40			#Friction coefficient

### Set linear velocity ### 

variable   vel1 equal -0.2			#Initial velocity (m/s)
variable   vel2 equal 0.0			#Initial velocity (m/s)

### Set Angular velocity ###

variable   omega1 equal 22.860			#Initial angular velocity for Small Particle (rad/s)
variable   omega2 equal	0.0			#Initial angular velocity for Large Particle (rad/s)

#################### NEW ###############################

variable	     CoR  equal 0.5		#Coefficient of Resistution


variable	     rho1 equal 2700		#Density (kg/L^3) for Small Particle
variable	     rho2 equal 1000*${rho1}	#Density (kg/L^3) for Large Particle


############################## Simulation parameters

atom_style      sphere
boundary        p p p

region 		box block -2 2 -2 2 -2 2
create_box 	2 box

create_atoms	1 single 0.100001 0 0
create_atoms	2 single -0.5 0 0

set		type 1 diameter 0.2
set		type 2 diameter 1.0

set		type 1 density ${rho1}
set		type 2 density ${rho2}

variable   	Tstep equal 0.01*PI*0.1*(${rho1}*2*(1+${poisson})/${Emod}) # 0.01*pi*rmin*sqrt(rho/G)
variable	runsteps equal round(${runtime}/${Tstep})

compute         mass all property/atom mass

run             0

neighbor        0.3 bin
neigh_modify    delay 0
comm_modify     vel yes

###             Grain-grain interaction
pair_style      granular
pair_coeff	* * hertz/material ${Emod} ${CoR} ${poisson} &
		damping coeff_restitution &
		tangential mindlin NULL 0.5 ${mus}
		
fix		1 all nve/sphere

group		right type 1
group		left type 2

run		0

variable 	STEP equal step

variable 	xcom1 equal xcm(right,x)
variable 	ycom1 equal xcm(right,y)
variable 	zcom1 equal xcm(right,z)
variable	vxcom1 equal vcm(right,x)
variable 	vycom1 equal vcm(right,y)
variable 	vzcom1 equal vcm(right,z)
variable	fxcom1 equal fcm(right,x)

variable        xcom2 equal xcm(left,x)
variable        ycom2 equal xcm(left,y)
variable        zcom2 equal xcm(left,z)
variable        vxcom2 equal vcm(left,x)
variable        vycom2 equal vcm(left,y)
variable        vzcom2 equal vcm(left,z)
variable        fxcom2 equal fcm(left,x)

#fix 		freeze all setforce 0.0 NULL NULL

run		0

velocity 	right set ${vel1} 0 0 
velocity	left set ${vel2} 0 0

############# Set angular velcity #############

set           group right omega 0 0 ${omega1} # Angular momenum about z axis
set           group left omega 0 0 0

compute	       omgx1 right property/atom omegax
compute        1 right reduce ave c_omgx1
variable       wcom1 equal c_1

compute        omgx2 left property/atom omegax
compute	       2 left reduce ave c_omgx2
variable       wcom2 equal c_2

fix 		OUT all print ${thermo_freq} "${STEP} ${xcom1} ${ycom1} ${zcom1} ${vxcom1} ${vycom1} ${vzcom1} ${fxcom1}" file contact.evol screen no

compute 	3 all pair/local p1 p4 p8

dump 		1 all local 100000 dump.data c_3[1] c_3[2] c_3[3]  
dump 		2 all custom 100000 dump.vis id type radius mass x y z vx vy vz fx fy fz omegax omegay omegaz 

timestep	${Tstep}
run		${runsteps}