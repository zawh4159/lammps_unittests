############################
### Simulation Parameters ##
############################
units           si
dimension       3
boundary        f f f

atom_style      sphere
region          box block -1 10 -1 1 -1 1
create_box      2 box

create_atoms    1 single 0 0 0.0025

neighbor        0.3 bin
neigh_modify    delay 0
comm_modify     vel yes

############################
### Numerical Parameters ###
############################
variable        dt equal 1e-6

variable        vel1 equal 1.0
variable        omega1 equal 0


variable        Nrun equal 5e6
variable        nout equal 100

############################
### Material Parameters  ###
############################
# Fixed constants
variable        Emod equal 1e4
variable        Poissons equal 0.33
variable        Rho equal 2700
variable        D equal 0.005

variable        e equal  1
variable        mu equal 0.4

#Set properties
set             type 1 diameter ${D}
set             type 1 density ${Rho}

############################
#  Wall & Pair Interacions #
############################
pair_style      granular
pair_coeff	    * * hertz/material ${Emod} ${e} ${Poissons} damping coeff_restitution tangential mindlin NULL 1 ${mu} #rolling sds 7000 0 0.4

fix             1 all wall/gran granular hertz/material ${Emod} ${e} ${Poissons} tangential mindlin NULL 1 ${mu} damping coeff_restitution zplane 0 1
run             0

############################
# Final fixes and computes #
############################
fix             2 all nve/sphere
variable 	    STEP equal step

group		    particle1 type 1

run             0

compute         1 particle1 property/atom omegay
compute         2 particle1 reduce ave c_1


variable 	    xcom1 equal xcm(particle1,x)
variable	    vxcom1 equal vcm(particle1,x)
variable	    vycom1 equal vcm(particle1,y)
variable	    fcom1 equal fcm(particle1,x)
variable        omg1 equal c_2

dump            1 all custom ${nout} dump/atom.dump id type xs ys zs vx vy vz fx fy fz 

fix             grav all gravity 1 vector 0 0 -1
timestep        0.001
run             10000

## Give particle its final velocity
velocity 	    particle1 set ${vel1} 0 0

# Dumps and prints
fix             printF all print ${nout} "${STEP} ${xcom1} ${vxcom1} ${vycom1} ${fcom1} ${omg1}" file dump/sliding_rolling.out screen no title ""

############################
# Run  #
############################
timestep        ${dt}
run             ${Nrun}